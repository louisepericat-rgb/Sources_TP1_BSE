  38          void main (void) {
  39   1        
  40   1              Init_Device();
  41   1              P3MDOUT &= 0x7F; // masque pour bit 7 à 0
  42   1              BP = 1; // ouvre le drain 
  43   1              
  44   1              P3IF &= 0xF7; //masque bit 3 à 0
  45   1              P3IF &= 0x7F; //masque bit 7 à 0
  46   1        
