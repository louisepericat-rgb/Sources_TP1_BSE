  48   3                }
  49   2                else if ( BP == 0 ){
  50   3                  ACK_BP = 1;
  51   3                }
  52   2              
  53   2                if ( ETAT_LED == 1){
  54   3                 LED = LED_ON;
  55   3                 Software_Delay(2); // Temporisation 20ms
